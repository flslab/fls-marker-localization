    "minimum_captures_per_bin": 2,
    "stable_frames": 6,
    "maximum_stable_motion_px": 1.5,
    "minimum_seconds_between_captures": 1.0,
    "minimum_descriptor_distance": 0.35,
    "settings_settled_frames": 5,
    "preview_scale": 1.5,
    "headless_preview_interval_s": 0.5
  },
  "split": {
    "validation_fraction": 0.25,
    "seed": 20260923,
    "spatial_bins": [
      4,
      3
    ]
