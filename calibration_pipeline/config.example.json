    "minimum_points_per_pose": 4,
    "spatial_bins": [
      8,
      5
    ],
    "minimum_points_per_spatial_bin": 10,
    "confidence": {
      "iterations": 1000,
      "seed": 20260925
    },
    "thresholds": {
      "require_mapping_valid": true,
      "maximum_validation_p95_px": 0.5,
