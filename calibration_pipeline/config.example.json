{
  "capture_metadata": {
    "camera_model": "DFRobot global-shutter camera",
    "camera_serial": "REPLACE_ME",
    "lens": "REPLACE_ME",
    "focus_setting": "fixed; record physical setting",
    "sensor_mode": "640x400 at 120 Hz",
    "exposure_time_us": 3000,
    "analogue_gain": 1.0,
    "target_id": "REPLACE_ME",
