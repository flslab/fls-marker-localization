  "models": [
    {
      "name": "opencv5",
      "type": "opencv",
      "flags": [],
      "minimum_views": 12,
      "deployment_compatible": true
    },
    {
      "name": "rational8",
      "type": "opencv",
      "flags": [
        "rational"
      ],
      "minimum_views": 15,
      "deployment_compatible": true
    },
    {
      "name": "thin_prism12",
      "type": "opencv",
      "flags": [
        "rational",
        "thin_prism"
      ],
      "minimum_views": 20,
